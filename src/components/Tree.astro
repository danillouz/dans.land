---
import type { GardenTreeNode } from "../garden/tree"

interface Props {
  showRoot?: boolean
  tree: GardenTreeNode
}

const { showRoot = false, tree } = Astro.props
---

<ul class="tree">
  {
    showRoot ? (
      <li class="root">
        <strong>{tree.name}</strong>
        <Astro.self tree={tree} />
      </li>
    ) : (
      tree.children.map((node) => (
        <li>
          {node.href ? (
            <a href={node.href}>{node.name}</a>
          ) : (
            <>
              <strong class="folder">{node.name}</strong>
              <Astro.self tree={node} />
            </>
          )}
        </li>
      ))
    )
  }
</ul>

<style>
  .tree {
    --tree-line-height: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .tree .tree {
    margin: 0 0 0 0.5ch;
    padding: 0;
  }

  .tree li {
    position: relative;
    min-height: var(--tree-line-height);
  }

  .tree .tree > li {
    margin-left: 0.5ch;
    padding-left: 2.5ch;
    border-left: 1px solid rgb(var(--garden-border));
  }

  .tree .tree > li::before {
    position: absolute;
    top: calc(var(--tree-line-height) / 2);
    left: 0;
    width: 2ch;
    border-bottom: 1px solid rgb(var(--garden-border));
    content: "";
  }

  .tree .tree > li:last-child {
    border-left: 0;
  }

  .tree .tree > li:last-child::after {
    position: absolute;
    top: 0;
    left: 0;
    height: calc(var(--tree-line-height) / 2);
    border-left: 1px solid rgb(var(--garden-border));
    content: "";
  }

  .folder {
    text-transform: capitalize;
  }
</style>
