---
import type { MarkdownHeading } from "astro"

interface Props {
  hasBacklinks?: boolean
  headings: MarkdownHeading[]
  title: string
}

const { hasBacklinks = false, headings, title } = Astro.props
const railHeadings = [
  { depth: 1, slug: "top", text: title },
  ...headings,
  ...(hasBacklinks
    ? [{ depth: 2, slug: "mentioned-in", text: "Mentioned in" }]
    : []),
]
const showRail = railHeadings.length >= 4
---

{
  showRail && (
    <nav
      class="toc-rail"
      aria-label="Table of Contents"
      data-toc-rail
      style={`--toc-items: ${railHeadings.length}`}
    >
      <ol>
        {railHeadings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              aria-label={heading.text}
              data-toc-link={heading.slug}
            >
              <span class="toc-tick" aria-hidden="true" />
              <span class="toc-popover garden-popover" aria-hidden="true">
                {heading.text}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc-rail {
    display: none;
  }

  @media (width >= 48rem) {
    .toc-rail {
      position: fixed;
      z-index: 10;
      top: 50%;
      left: clamp(0.75rem, 2vw, 1.5rem);
      display: block;
      width: 3rem;
      height: min(80vh, max(4rem, calc(var(--toc-items) * 1rem)));
      transform: translateY(-50%);
    }

    .toc-rail ol {
      display: flex;
      flex-direction: column;
      height: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .toc-rail li {
      display: flex;
      flex: 1;
      align-items: center;
      min-height: 0.625rem;
    }

    .toc-rail a {
      position: relative;
      display: flex;
      align-items: center;
      width: 3rem;
      height: 100%;
      color: rgb(var(--garden-description));
      text-decoration: none;
    }

    .toc-tick {
      width: 2.5rem;
      height: 2px;
      background: currentColor;
      opacity: 0.55;
      transform: scaleX(0.3);
      transform-origin: left;
      transition: transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .toc-rail li:has(+ li > a:is(:hover, :focus-visible)) .toc-tick,
    .toc-rail li:is(:hover, :focus-within) + li .toc-tick {
      opacity: 0.8;
      transform: scaleX(0.6);
    }

    .toc-rail li:has(+ li + li > a:is(:hover, :focus-visible)) .toc-tick,
    .toc-rail li:is(:hover, :focus-within) + li + li .toc-tick {
      opacity: 0.65;
      transform: scaleX(0.4);
    }

    .toc-rail a[aria-current="location"] .toc-tick {
      color: rgb(var(--color-text));
      opacity: 1;
    }

    .toc-rail a:is(:hover, :focus-visible) .toc-tick {
      color: rgb(var(--color-text));
      opacity: 1;
      transform: scaleX(1);
    }

    .toc-rail a:focus-visible {
      outline: none;
    }

    .toc-rail a:focus-visible .toc-tick {
      outline: 2px solid rgb(var(--focus));
      outline-offset: 3px;
    }

    .toc-popover {
      position: absolute;
      left: calc(100% + 0.5rem);
      width: max-content;
      max-width: min(20rem, calc(100vw - 8rem));
      padding: 0.45rem 0.625rem;
      color: rgb(var(--color-text));
      font-size: 0.9375rem;
      line-height: 1.3;
      opacity: 0;
      pointer-events: none;
      transform: translateX(-0.25rem) scale(0.99);
      transform-origin: left center;
      transition: transform 100ms cubic-bezier(0.2, 0.8, 0.2, 1);
      visibility: hidden;
    }

    .toc-rail a:is(:hover, :focus-visible) .toc-popover {
      opacity: 1;
      transform: translateX(0) scale(1);
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-tick,
    .toc-popover {
      transition: none;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>("[data-toc-rail]")
  if (rail) {
    const items = [
      ...rail.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ].flatMap((link) => {
      const slug = link.dataset.tocLink
      const target = slug ? document.getElementById(slug) : null
      return target ? [{ link, target }] : []
    })

    let scheduled = false

    const updateCurrentHeading = () => {
      const threshold = window.innerHeight * 0.25
      let current = items[0]

      for (const item of items) {
        if (item.target.getBoundingClientRect().top <= threshold) {
          current = item
        } else {
          break
        }
      }

      for (const { link } of items) {
        if (link === current?.link) {
          link.setAttribute("aria-current", "location")
        } else {
          link.removeAttribute("aria-current")
        }
      }

      scheduled = false
    }

    const scheduleUpdate = () => {
      if (!scheduled) {
        scheduled = true
        requestAnimationFrame(updateCurrentHeading)
      }
    }

    updateCurrentHeading()
    window.addEventListener("scroll", scheduleUpdate, { passive: true })
    window.addEventListener("resize", scheduleUpdate)
  }
</script>
