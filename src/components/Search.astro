---
import { getSearchIndex, sitePages } from "../search/index-build"

const searchIndex = await getSearchIndex()
---

<button
  class="nav-link search-trigger"
  type="button"
  aria-label="Search"
  aria-haspopup="dialog"
  aria-keyshortcuts="Meta+K Control+K"
  title="I'm Crumb. The tiniest and sole Steward of Dan's Land."
  data-search-open
>
  <span class="search-pet" aria-hidden="true">
    <span class="search-pet-idle">ᴖᴗᴖ</span>
    <span class="search-pet-active">&gt;ᴗ&lt;</span>
  </span>
</button>

<dialog
  class="search-dialog"
  aria-label="Search Dan's Land"
  aria-describedby="search-help"
  data-site-search
  data-search-index={searchIndex.url}
>
  <div class="search-panel">
    <form class="search-form" role="search" data-search-form>
      <label class="sr-only" for="site-search-input">Search Dan's Land</label>

      <input
        id="site-search-input"
        type="search"
        role="combobox"
        inputmode="search"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="Search Dan's Land..."
        aria-autocomplete="list"
        aria-controls="search-results"
        aria-expanded="false"
        data-search-input
      />
    </form>

    <button
      class="search-action search-close"
      type="button"
      aria-label="Close search"
      data-search-close>Close</button
    >

    <div class="search-scroll" tabindex="-1" data-search-scroll>
      <p class="search-status sr-only" role="status" data-search-status></p>

      <div
        id="search-results"
        class="search-results"
        role="listbox"
        aria-label="Search results"
      >
        <div
          class="search-group"
          role="group"
          aria-labelledby="search-shortcuts-heading"
          data-search-shortcuts
        >
          <h3 class="search-group-heading" id="search-shortcuts-heading">
            Pages <span>{sitePages.length}</span>
          </h3>

          <ul class="search-result-list" role="presentation">
            {
              sitePages.map(({ path, title }, index) => (
                <li role="presentation">
                  <a
                    id={`search-shortcut-${index}`}
                    class="search-result"
                    href={path}
                    role="option"
                    aria-selected="false"
                    tabindex="-1"
                  >
                    <span class="search-result-marker" aria-hidden="true">
                      &gt;
                    </span>
                    <strong>{title}</strong>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div data-search-results role="presentation"></div>
      </div>

      <div data-search-message></div>

      <button
        class="search-action search-list-action"
        type="button"
        data-search-retry
        hidden>Retry</button
      >
      <p id="search-help" class="search-help">
        <span class="search-help-item">
          <span class="kbd-group"><kbd>↑</kbd><kbd>↓</kbd></span> roam
        </span>

        <span class="search-help-item"><kbd>Enter</kbd> visit</span>

        <span class="search-help-item"><kbd>Esc</kbd> clear / dismiss</span>

        <span class="search-help-item">
          <span class="kbd-group"
            ><kbd data-search-modifier>⌘</kbd><kbd>K</kbd></span
          > summon
        </span>
      </p>
    </div>
  </div>
</dialog>

<script>
  import {
    prepareSearchIndex,
    searchEntries,
    searchResultHref,
    type PreparedSearchEntry,
  } from "../search/client"
  import { highlightedText } from "../search/highlight"
  import { normalizeSearchText, searchTermPositions } from "../search/text"
  import type { RankedSearchEntry, SearchEntry } from "../search/types"

  const searchParameter = "search"
  const resultBatchSize = 10
  const dialog = document.querySelector<HTMLDialogElement>("[data-site-search]")
  const openButton =
    document.querySelector<HTMLButtonElement>("[data-search-open]")
  const form = document.querySelector<HTMLFormElement>("[data-search-form]")
  const input = document.querySelector<HTMLInputElement>("[data-search-input]")
  const status = document.querySelector<HTMLElement>("[data-search-status]")
  const closeButton = document.querySelector<HTMLButtonElement>(
    "[data-search-close]",
  )
  const retryButton = document.querySelector<HTMLButtonElement>(
    "[data-search-retry]",
  )
  const popup = document.getElementById("search-results")
  const shortcuts = document.querySelector<HTMLElement>(
    "[data-search-shortcuts]",
  )
  const results = document.querySelector<HTMLElement>("[data-search-results]")
  const message = document.querySelector<HTMLElement>("[data-search-message]")
  const scrollArea = document.querySelector<HTMLElement>("[data-search-scroll]")
  const shortcutModifier = document.querySelector<HTMLElement>(
    "[data-search-modifier]",
  )

  let indexRequest: Promise<PreparedSearchEntry[]> | undefined
  let requestToken = 0
  let isComposing = false
  let renderedLinks: HTMLAnchorElement[] = []
  let activeIndex = -1
  let appendResults: (() => void) | undefined

  class SearchIndexError extends Error {
    constructor(readonly status: number) {
      super(`Search index: ${status}`)
    }
  }

  function loadIndex() {
    indexRequest ??= fetch(dialog?.dataset.searchIndex ?? "")
      .then((response) => {
        if (!response.ok) {
          throw new SearchIndexError(response.status)
        }

        return response.json() as Promise<SearchEntry[]>
      })
      .then(prepareSearchIndex)
      .catch((error) => {
        indexRequest = undefined
        throw error
      })
    return indexRequest
  }

  function makeResult(
    entry: RankedSearchEntry,
    terms: string[],
    index: number,
  ) {
    const item = document.createElement("li")
    const link = document.createElement("a")
    const marker = document.createElement("span")
    const title = document.createElement("strong")

    item.setAttribute("role", "presentation")
    link.href = searchResultHref(entry)
    link.id = `search-result-${index}`
    link.className = "search-result"
    link.classList.toggle(
      "search-result-quiet",
      terms.length === 1 && /^\p{L}$/u.test(terms[0]),
    )
    link.tabIndex = -1
    link.setAttribute("role", "option")
    link.setAttribute("aria-selected", "false")
    renderedLinks.push(link)
    marker.className = "search-result-marker"
    marker.setAttribute("aria-hidden", "true")
    marker.textContent = ">"
    title.title = entry.title
    title.append(highlightedText(entry.title, terms))
    link.append(marker, title)
    if (entry.kind === "garden") {
      link.classList.add("search-result-post")
      const snippet = document.createElement("span")
      snippet.className = "search-result-snippet"
      const preview = entry.sectionTitle ?? entry.snippet
      snippet.append(highlightedText(preview, terms))
      link.append(snippet)

      const matchesQuery = (value: string) => {
        const text = normalizeSearchText(value)
        return terms.some(
          (term) => searchTermPositions(text, term, true, 1).length > 0,
        )
      }
      const alias = entry.aliases.find(matchesQuery) ?? entry.aliases[0]
      const detail = alias ?? entry.tags.find(matchesQuery)
      if (detail) {
        const metadata = document.createElement("span")
        const label = alias ? "Alias: " : "Tag: "
        metadata.className = "search-result-meta"
        metadata.title = label + detail
        metadata.append(label, highlightedText(detail, terms))
        link.append(metadata)
      }
    }
    item.append(link)
    return item
  }

  function renderMessage(title: string, description: string) {
    if (!message) {
      return
    }

    const empty = document.createElement("div")
    const ornament = document.createElement("span")
    const heading = document.createElement("strong")
    const hint = document.createElement("p")

    empty.className = "search-empty"
    ornament.className = "search-empty-ornament"
    ornament.setAttribute("aria-hidden", "true")
    ornament.textContent = ">_<"
    heading.textContent = title
    hint.textContent = description
    empty.append(ornament, heading, hint)
    message.append(empty)
  }

  function renderEmpty() {
    renderMessage(
      "Behold! Nothing.",
      "I searched all of Dan's Land to no avail. I even asked the High Warden. He wants cinnamon buns.",
    )
  }

  function setActiveResult(index: number, scroll = true) {
    const previous = renderedLinks[activeIndex]
    const active = renderedLinks[index]
    if (previous && previous !== active) {
      previous.classList.remove("is-active")
      previous.setAttribute("aria-selected", "false")
    }
    activeIndex = index
    if (!active) {
      input?.removeAttribute("aria-activedescendant")
      input?.setAttribute("aria-expanded", "false")
      return
    }

    active.classList.add("is-active")
    active.setAttribute("aria-selected", "true")
    input?.setAttribute("aria-activedescendant", active.id)
    input?.setAttribute("aria-expanded", "true")
    if (scroll) {
      active.scrollIntoView({ block: "nearest" })
    }
  }

  function appendNearEnd() {
    if (!scrollArea) {
      return
    }
    while (
      appendResults &&
      scrollArea.scrollHeight -
        scrollArea.clientHeight -
        scrollArea.scrollTop <=
        80
    ) {
      appendResults()
    }
  }

  function appendGroup(parent: HTMLElement, label: string, count: number) {
    const group = document.createElement("div")
    const heading = document.createElement("h3")
    const total = document.createElement("span")
    const list = document.createElement("ol")

    heading.id = `search-group-${parent.children.length}`
    heading.className = "search-group-heading"
    total.textContent = String(count)
    heading.append(`${label} `, total)
    group.className = "search-group"
    group.setAttribute("role", "group")
    group.setAttribute("aria-labelledby", heading.id)
    list.className = "search-result-list"
    list.setAttribute("role", "presentation")
    group.append(heading, list)
    parent.append(group)
    return list
  }

  function render(query: string, entries: PreparedSearchEntry[]) {
    if (!results || !status || !popup) {
      return
    }

    const matches = searchEntries(entries, query, Infinity)
    status.classList.add("sr-only")
    if (!matches.total) {
      status.textContent = "No results found."
      renderEmpty()
      return
    }

    const pages = matches.entries.filter((entry) => entry.kind === "page")
    const posts = matches.entries.filter((entry) => entry.kind === "garden")
    const ordered = [...pages, ...posts]
    let list = pages.length
      ? appendGroup(results, "Pages", pages.length)
      : appendGroup(results, "Garden posts", posts.length)
    popup.hidden = false
    status.textContent = `${matches.total} ${matches.total === 1 ? "result" : "results"}`
    appendResults = () => {
      const start = renderedLinks.length
      for (const entry of ordered.slice(start, start + resultBatchSize)) {
        if (pages.length && renderedLinks.length === pages.length) {
          list = appendGroup(results, "Garden posts", posts.length)
        }
        list.append(makeResult(entry, matches.terms, renderedLinks.length))
      }
      if (renderedLinks.length === matches.total) {
        appendResults = undefined
      }
    }
    appendResults()
    setActiveResult(0, false)
    appendNearEnd()
  }

  function updateUrl(query: string | null) {
    const url = new URL(window.location.href)
    if (query === null) {
      url.searchParams.delete(searchParameter)
    } else {
      url.searchParams.set(searchParameter, query)
    }
    history.replaceState(history.state, "", url)
  }

  function resetResults() {
    setActiveResult(-1, false)
    renderedLinks = []
    appendResults = undefined
    if (popup) {
      popup.hidden = true
    }
    results?.replaceChildren()
    message?.replaceChildren()
    if (scrollArea) {
      scrollArea.scrollTop = 0
    }
  }

  async function search() {
    if (!input || !status || !dialog?.open) {
      return
    }

    const thisRequest = ++requestToken
    const query = input.value.trim()
    resetResults()
    if (retryButton) {
      retryButton.hidden = true
    }
    if (shortcuts) {
      shortcuts.hidden = Boolean(query)
    }
    if (!query) {
      status.classList.add("sr-only")
      status.textContent = ""
      if (popup && shortcuts) {
        popup.hidden = false
        renderedLinks = Array.from(
          shortcuts.querySelectorAll("a.search-result"),
        )
        setActiveResult(0, false)
      }
      return
    }

    const loadingNotice = window.setTimeout(() => {
      if (thisRequest !== requestToken || !dialog.open) {
        return
      }
      status.textContent = "Consulting the archives…"
      status.classList.remove("sr-only")
    }, 200)
    try {
      const entries = await loadIndex()
      if (thisRequest !== requestToken || !dialog.open) {
        return
      }
      render(query, entries)
    } catch (error) {
      console.error("Unable to load the search index.", error)
      if (thisRequest !== requestToken || !dialog.open) {
        return
      }

      const needsReload =
        error instanceof SearchIndexError && [404, 410].includes(error.status)
      status.textContent = needsReload
        ? "Reload this page to continue searching."
        : "Search is unavailable right now."
      status.classList.add("sr-only")
      if (needsReload) {
        renderMessage(
          "The archives have moved.",
          "Reload this page to continue searching.",
        )
      } else {
        renderMessage("Crumb fell asleep.", "Try waking it in a moment.")
      }
      if (retryButton) {
        retryButton.textContent = needsReload ? "Reload page" : "Retry"
        retryButton.onclick = needsReload
          ? () => window.location.reload()
          : () => {
              input.focus()
              search()
            }
        retryButton.hidden = false
      }
    } finally {
      window.clearTimeout(loadingNotice)
    }
  }

  function openSearch(query = input?.value ?? "", updateHistory = true) {
    if (!dialog || !input) {
      return
    }

    input.value = query

    if (updateHistory) {
      updateUrl(query.trim())
    }
    if (!dialog.open) {
      dialog.showModal()
    }
    document.documentElement.classList.add("search-open")
    search()
    if (!query.trim()) {
      void loadIndex().catch(() => {})
    }
    requestAnimationFrame(() => {
      if (dialog.open) {
        input.focus()
      }
    })
  }

  function closeSearch(updateHistory = true) {
    if (!dialog?.open) {
      return
    }

    if (updateHistory) {
      updateUrl(null)
    }
    requestToken += 1
    isComposing = false
    setActiveResult(-1, false)
    dialog.close()
  }

  function clearOrCloseSearch() {
    if (!input) {
      return
    }

    if (input.value) {
      input.value = ""
      updateUrl("")
      search()
      return
    }

    closeSearch()
  }

  function syncFromUrl() {
    const url = new URL(window.location.href)
    if (url.searchParams.has(searchParameter)) {
      openSearch(url.searchParams.get(searchParameter) ?? "", false)
    } else {
      closeSearch(false)
    }
  }

  openButton?.addEventListener("click", () => openSearch())
  input?.addEventListener("compositionstart", () => {
    isComposing = true
  })
  input?.addEventListener("compositionend", () => {
    isComposing = false
    if (!input || !dialog?.open) {
      return
    }
    updateUrl(input.value.trim())
    search()
  })
  input?.addEventListener("input", (event) => {
    if (
      dialog?.open === false ||
      isComposing ||
      (event as InputEvent).isComposing
    ) {
      return
    }
    updateUrl(input.value.trim())
    search()
  })
  input?.addEventListener("keydown", (event) => {
    if (isComposing || event.isComposing) {
      if (event.key === "Enter") {
        event.preventDefault()
      }
      return
    }

    if (
      event.key === "Tab" &&
      retryButton?.hidden !== false &&
      !closeButton?.getClientRects().length
    ) {
      event.preventDefault()
      return
    }

    if (event.key === "Escape") {
      event.preventDefault()
      clearOrCloseSearch()
      return
    }

    if (!renderedLinks.length) {
      return
    }

    let nextIndex: number
    switch (event.key) {
      case "Home":
        nextIndex = 0
        break
      case "End":
        while (appendResults) {
          appendResults()
        }
        nextIndex = renderedLinks.length - 1
        break
      case "ArrowUp":
        if (activeIndex === 0) {
          while (appendResults) {
            appendResults()
          }
        }
        nextIndex =
          (activeIndex - 1 + renderedLinks.length) % renderedLinks.length
        break
      case "ArrowDown":
        if (activeIndex === renderedLinks.length - 1) {
          appendResults?.()
        }
        nextIndex = (activeIndex + 1) % renderedLinks.length
        break
      default:
        return
    }
    event.preventDefault()
    setActiveResult(nextIndex)
  })
  form?.addEventListener("submit", (event) => {
    event.preventDefault()
    if (isComposing) {
      return
    }
    const selected = renderedLinks[activeIndex]
    if (selected) {
      window.location.href = selected.href
    }
  })
  popup?.addEventListener("pointermove", (event) => {
    if (event.pointerType !== "mouse") {
      return
    }
    const link = (event.target as Element).closest<HTMLAnchorElement>(
      ".search-result",
    )
    const index = link ? renderedLinks.indexOf(link) : -1
    if (index >= 0 && index !== activeIndex) {
      setActiveResult(index, false)
    }
  })
  scrollArea?.addEventListener("scroll", appendNearEnd)
  closeButton?.addEventListener("click", () => closeSearch())
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      closeSearch()
    }
  })
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault()
    clearOrCloseSearch()
  })
  dialog?.addEventListener("close", () => {
    if (dialog.open) {
      return
    }
    document.documentElement.classList.remove("search-open")
    if (input) {
      input.value = ""
    }
  })
  document.addEventListener("keydown", (event) => {
    if (
      event.key.toLocaleLowerCase() !== "k" ||
      !(event.metaKey || event.ctrlKey)
    ) {
      return
    }
    event.preventDefault()
    if (dialog?.open) {
      input?.focus()
      input?.select()
    } else {
      openSearch()
    }
  })
  if (shortcutModifier && !/(Mac|iPhone|iPad|iPod)/i.test(navigator.platform)) {
    shortcutModifier.textContent = "Ctrl"
  }
  window.addEventListener("popstate", syncFromUrl)
  syncFromUrl()
</script>

<style>
  :global(html.search-open) {
    overflow: hidden;
  }

  :global(html.search-open body > main),
  :global(html.search-open body > footer),
  :global(html.search-open .site-header .nav-link) {
    filter: blur(3px);
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-code);
  }

  .search-trigger::before,
  .search-trigger::after {
    content: none;
  }

  .search-pet {
    display: inline-grid;
    width: 3ch;
    place-items: center;
  }

  .search-pet-idle,
  .search-pet-active {
    grid-area: 1 / 1;
  }

  .search-pet-active {
    visibility: hidden;
  }

  .search-trigger:is(:hover, :focus-visible) .search-pet-idle {
    visibility: hidden;
  }

  .search-trigger:is(:hover, :focus-visible) .search-pet-active {
    visibility: visible;
  }

  .search-trigger:focus-visible {
    outline: 2px solid rgb(var(--focus));
    outline-offset: 0;
  }

  .search-dialog {
    width: min(calc(100% - 2rem), 42rem);
    height: min(42rem, calc(100dvh - 2rem));
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(var(--color-muted));
    border-radius: var(--radius);
    outline: none;
    background: rgb(var(--color-surface));
    color: rgb(var(--color-text));
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.48);
  }

  .search-panel {
    box-sizing: border-box;
    display: grid;
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr);
    padding: 1.25rem 1.25rem 0;
  }

  .search-scroll {
    display: flex;
    grid-column: 1 / -1;
    min-height: 0;
    flex-direction: column;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    overflow-anchor: none;
    scrollbar-color: rgb(var(--color-muted)) transparent;
  }

  .search-form {
    display: grid;
    min-height: 3.25rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    border: 1px solid rgb(var(--color-muted));
    border-radius: var(--radius);
    background: rgb(var(--color-base));
  }

  .search-form input {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 3.125rem;
    padding: 0.625rem 0.875rem;
    border: 0;
    outline: none;
    background: transparent;
    color: rgb(var(--color-text));
    font: inherit;
    font-family: var(--font-ui);
  }

  .search-form input::placeholder {
    color: rgb(var(--color-caption));
  }

  .search-form:focus-within {
    outline: 2px solid rgb(var(--focus));
    outline-offset: -2px;
  }

  .search-action {
    min-height: 2.75rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgb(var(--color-muted) / 0.5);
    border-radius: var(--radius);
    background: rgb(var(--color-base));
    color: rgb(var(--color-caption));
    font: inherit;
    font-size: var(--font-size-ui);
    cursor: pointer;
  }

  .search-action:hover {
    color: rgb(var(--color-text));
    border-color: rgb(var(--color-muted));
  }

  .search-action:focus-visible {
    outline: 2px solid rgb(var(--focus));
    outline-offset: 2px;
  }

  .search-close {
    display: none;
  }

  .search-list-action {
    align-self: center;
    margin: 0.75rem 0 0;
  }

  .search-status:not(.sr-only) {
    min-height: 1.1rem;
    margin: 0.45rem 0 0;
    color: rgb(var(--color-caption));
    font-family: var(--font-code);
    font-size: 0.75rem;
  }

  .search-results:not([hidden]) {
    margin: 0.75rem 0 0;
  }

  .search-results :global(.search-group + .search-group) {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid rgb(var(--color-muted) / 0.45);
  }

  .search-results :global(.search-group-heading) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 0.45rem 0.75rem 0.35rem;
    border: 0;
    color: rgb(var(--color-caption));
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .search-results :global(.search-result-list) {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    padding: 0.15rem 0;
    list-style: none;
  }

  .search-results :global(.search-result) {
    --search-preview-line-height: calc(var(--font-size-copy) * 1.4);
    --search-result-row-gap: 0.125rem;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr) fit-content(40%);
    width: 100%;
    min-height: 2.75rem;
    align-content: center;
    gap: var(--search-result-row-gap) 0.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .search-results :global(:where(li:nth-child(even)) > .search-result-post) {
    background: rgb(var(--color-overlay) / 0.35);
  }

  .search-results :global(.search-result.is-active),
  .search-results :global(.search-result:focus-visible) {
    background: rgb(var(--color-overlay));
