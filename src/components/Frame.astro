---
import Footer from "./Footer.astro"
import Header from "./Header.astro"
---

<Header />

<main>
  <slot />
</main>

<Footer />

<style>
  main {
    box-sizing: border-box;
    /* Quattro's 70ch is 42rem; keep the column stable while fonts load. */
    width: min(calc(100% - 2.5rem), 42rem);
    flex: 1 1 0%;
    margin-inline: auto;
    padding-block: 3rem;
  }
</style>
