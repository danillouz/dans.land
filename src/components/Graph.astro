---
import type { GardenGraphData } from "../garden/graph"

interface Props {
  graph: GardenGraphData
}

const { graph } = Astro.props
const serializedGraph = JSON.stringify(graph).replaceAll("<", "\\u003c")
---

<figure class="garden-graph" data-garden-graph>
  <svg
    height="600"
    role="group"
    aria-label="Garden constellations"
    aria-describedby="garden-graph-description"
  >
    <desc id="garden-graph-description">
      A star map of published garden posts. Paths connect posts that link to one
      another. Drag to pan, scroll or pinch to zoom, and select a post to open
      it.
    </desc>
  </svg>

  <div class="graph-controls" role="group" aria-label="Star map controls">
    <button type="button" aria-label="Zoom out" data-graph-zoom="0.75">−</button
    >
    <button type="button" data-graph-reset>Reset</button>
    <button type="button" aria-label="Zoom in" data-graph-zoom="1.25">+</button>
  </div>

  <script
    type="application/json"
    data-graph-data
    is:inline
    set:html={serializedGraph}
  />
</figure>

<script>
  import type { GardenGraphData } from "../garden/graph"

  for (const root of document.querySelectorAll<HTMLElement>("[data-garden-graph]")) {
    const data = root.querySelector<HTMLScriptElement>("[data-graph-data]")
    if (!data?.textContent) {
      continue
    }

    const graph = JSON.parse(data.textContent) as GardenGraphData
    let graphModule: Promise<typeof import("../garden/graph-client")> | undefined
    let drawing = false
    let redrawPending = false
    let drawingWidth = 0
    let previousWidth = 0
    const redraw = () => {
      const width = Math.round(root.getBoundingClientRect().width)
      if (!width) {
        previousWidth = 0
        if (drawing) redrawPending = true
        return
      }
      if (drawing) {
        if (width !== drawingWidth) redrawPending = true
        return
      }
      if (width === previousWidth) return

      drawing = true
      drawingWidth = width
      let drawn = false
      graphModule ??= import("../garden/graph-client")
      graphModule
        .then(({ drawGraph }) => {
          drawGraph(root, graph)
          drawn = true
        })
        .catch((error) => {
          graphModule = undefined
          console.error("Unable to load the garden graph.", error)
        })
        .finally(() => {
          drawing = false
          const currentWidth = Math.round(root.getBoundingClientRect().width)
          if (!drawn) {
            previousWidth = 0
            redrawPending = false
          } else if (redrawPending || currentWidth !== drawingWidth) {
            redrawPending = false
            redraw()
          } else {
            previousWidth = drawingWidth
          }
        })
    }

    new ResizeObserver(redraw).observe(root)
    redraw()
  }
</script>

<style>
  .garden-graph {
    position: relative;
    margin: 2rem 0;
  }

  .garden-graph svg {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid rgb(var(--garden-border));
    border-radius: var(--garden-radius);
    background: rgb(var(--color-base));
    cursor: grab;
    touch-action: none;
  }

  .garden-graph svg:active {
    cursor: grabbing;
  }

  .graph-controls {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    overflow: hidden;
    border: 1px solid rgb(var(--garden-border));
    border-radius: var(--garden-radius);
    background: rgb(var(--color-base) / 0.92);
  }

  .graph-controls button {
    min-width: 2rem;
    padding: 0.125rem 0.5rem;
    border: 0;
    background: transparent;
    color: rgb(var(--nav-link));
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .graph-controls button + button {
    border-left: 1px solid rgb(var(--garden-border));
  }

  .graph-controls button:is(:hover, :focus-visible) {
    background: rgb(var(--color-overlay));
  }

  .graph-controls button:focus-visible {
    position: relative;
    outline: 2px solid rgb(var(--focus));
    outline-offset: -2px;
  }

  .garden-graph :global(.graph-edges line) {
    stroke: rgb(var(--garden-border));
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition:
      opacity 120ms ease-out,
      stroke 120ms ease-out;
  }

  .garden-graph :global(.graph-edges line[data-connected]) {
    stroke: rgb(var(--color-rose));
  }

  .garden-graph :global(.graph-nodes a) {
    color: rgb(var(--garden-description));
    outline: none;
    text-decoration: none;
    transition: opacity 120ms ease-out;
  }

  .garden-graph :global(.graph-nodes a[data-connected]) {
    color: rgb(var(--color-rose));
  }

  .garden-graph :global(.graph-nodes circle) {
    fill: currentColor;
    stroke: rgb(var(--color-base));
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .garden-graph :global(.graph-nodes a[data-connected] circle:not(.node-hit)) {
    filter: drop-shadow(0 0 2px rgb(var(--color-rose) / 0.35));
  }

  .garden-graph :global(.graph-nodes .node-hit) {
    fill: transparent;
    stroke: none;
  }

  .garden-graph :global(.graph-nodes text) {
    fill: rgb(var(--color-text));
    font-family: var(--font-body);
    font-size: 0.75rem;
    paint-order: stroke;
    stroke: rgb(var(--color-base));
    stroke-linejoin: round;
    stroke-width: 3px;
  }

  .garden-graph
    :global(.graph-nodes a:is(:hover, :focus-visible) circle:not(.node-hit)) {
    fill: rgb(var(--color-gold));
    stroke: rgb(var(--focus));
    stroke-width: 2;
    filter: drop-shadow(0 0 3px rgb(var(--color-gold) / 0.55));
  }

  .garden-graph :global([data-dimmed]) {
    opacity: 0.16;
  }

  @media (prefers-reduced-motion: reduce) {
    .garden-graph :global(.graph-edges line),
    .garden-graph :global(.graph-nodes a) {
      transition: none;
    }
  }
</style>
