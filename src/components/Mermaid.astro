<script>
  const diagrams = document.querySelectorAll<HTMLElement>("pre.mermaid")
  const developmentDiagrams = import.meta.env.DEV
    ? [...diagrams].map((diagram) => ({
        diagram,
        title: diagram.textContent?.match(/^\s*accTitle:\s*(.+)$/m)?.[1],
      }))
    : []
  let rendering: Promise<void> | undefined

  function renderDiagrams() {
    return (rendering ??= render())
  }

  async function render() {
    const { default: mermaid } = await import("mermaid")

    const styles = getComputedStyle(document.documentElement)
    const color = (name: string) => {
      const channels = styles.getPropertyValue(name).trim().split(/\s+/)
      return `#${channels
        .map((channel) => Number(channel).toString(16).padStart(2, "0"))
        .join("")}`
    }

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      fontFamily: "ui-sans-serif, system-ui, sans-serif",
      themeVariables: {
        background: color("--color-surface"),
        primaryColor: color("--color-base"),
        primaryTextColor: color("--color-text"),
        primaryBorderColor: color("--color-pine"),
        lineColor: color("--color-subtle"),
        secondaryColor: color("--color-overlay"),
        tertiaryColor: color("--color-base"),
        textColor: color("--color-text"),
      },
    })

    await mermaid.run({ nodes: diagrams })

    // Mermaid can produce slightly different fractional viewBox dimensions
    // across browsers. Whole-pixel metadata plus a small tolerance keeps the
    // development calibration useful without reporting harmless sub-pixel drift.
    const dimensionTolerance = 1
    for (const { diagram, title } of developmentDiagrams) {
      const frame = diagram.closest<HTMLElement>(".mermaid-frame")
      const viewBox = diagram
        .querySelector("svg")
        ?.getAttribute("viewBox")
        ?.trim()
        .split(/\s+/)
      const width = viewBox?.[2]
      const height = viewBox?.[3]
      if (!frame || !width || !height) {
        continue
      }

      const configuredWidth = Number(frame.dataset.mermaidWidth)
      const configuredHeight = Number(frame.dataset.mermaidHeight)
      const measuredWidth = Number(width)
      const measuredHeight = Number(height)
      const dimensionsMatch =
        Number.isFinite(configuredWidth) &&
        Number.isFinite(configuredHeight) &&
        Math.abs(configuredWidth - measuredWidth) <= dimensionTolerance &&
        Math.abs(configuredHeight - measuredHeight) <= dimensionTolerance
      if (dimensionsMatch) {
        continue
      }

      const label = title ? ` "${title}"` : ""
      console.warn(
        `[Mermaid]${label}: use \`\`\`mermaid width=${Math.ceil(measuredWidth)} height=${Math.ceil(measuredHeight)}`,
        frame,
      )
    }
  }

  if (diagrams.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        void renderDiagrams().catch((error) => {
          console.error("Could not render Mermaid diagrams", error)
        })
      },
      { rootMargin: "300px" },
    )
    diagrams.forEach((diagram) => observer.observe(diagram))
  }
</script>
