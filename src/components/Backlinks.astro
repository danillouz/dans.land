---
interface Backlink {
  href: string
  title: string
}

interface Props {
  backlinks: Backlink[]
  followsFootnotes?: boolean
}

const { backlinks, followsFootnotes = false } = Astro.props
---

{
  backlinks.length > 0 && (
    <section
      class:list={[
        "backlinks",
        { "backlinks--after-footnotes": followsFootnotes },
      ]}
      aria-labelledby="mentioned-in"
    >
      <h2 id="mentioned-in">
        <a class="heading-link" href="#mentioned-in">
          Mentioned in
        </a>
      </h2>

      <ul>
        {backlinks.map((backlink) => (
          <li>
            <a href={backlink.href} data-garden-link>
              {backlink.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .backlinks {
    margin-top: var(--garden-divider-spacing);
    padding-top: var(--garden-divider-spacing);
    border-top: 1px solid rgb(var(--garden-border));
  }

  .backlinks h2 {
    margin-top: 0;
  }

  .backlinks--after-footnotes {
    margin-top: 3rem;
    padding-top: 0;
    border-top: 0;
  }

  .backlinks ul {
    padding-inline-start: 1.75rem;
  }

  .backlinks li {
    padding-inline-start: 0.25rem;
    margin-block: 0.45rem;
  }

  .backlinks li::marker {
    color: rgb(var(--garden-description));
    font-weight: 700;
  }
</style>
