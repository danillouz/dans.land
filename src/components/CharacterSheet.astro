---
import { Picture } from "astro:assets"

import portrait from "../assets/portrait.png"
---

<section class="character-sheet" aria-labelledby="character-title">
  <span
    class="frame-corner frame-corner-top frame-corner-left"
    aria-hidden="true"></span>
  <span
    class="frame-corner frame-corner-top frame-corner-right"
    aria-hidden="true"></span>
  <span
    class="frame-corner frame-corner-bottom frame-corner-left"
    aria-hidden="true"></span>
  <span
    class="frame-corner frame-corner-bottom frame-corner-right"
    aria-hidden="true"></span>

  <header class="character-header">
    <h2 id="character-title" class="character-title">
      <span>Daniël Illouz &amp; Silvester Stallion</span>
    </h2>
  </header>

  <div class="character-body">
    <figure class="portrait-frame">
      <div class="portrait-art">
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          class="portrait-image"
          alt="Daniël Illouz wearing armor and riding a toy horse"
          priority
        />
      </div>
    </figure>

    <div class="character-details">
      <h3>Special abilities</h3>

      <ul class="character-abilities">
        <li>Summon immortal Gopher army</li>
        <li>Incident foresight</li>
        <li>10x damage to invisible bugs</li>
      </ul>

      <h3>Inventory</h3>

      <ul class="character-inventory">
        <li>Oats</li>
        <li>Cinnamon buns</li>
        <li>MacBook Pro</li>
        <li>Kindle</li>
        <li>Walking shoes</li>
      </ul>

      <h3>Mount</h3>

      <dl class="character-mount">
        <dt>Breed</dt>
        <dd>100% polyester</dd>

        <dt>Top speed</dt>
        <dd>0 km/h</dd>

        <dt>Weakness</dt>
        <dd>stairs</dd>
      </dl>
    </div>
  </div>
</section>

<style>
  .character-sheet {
    --frame-accent: rgb(var(--color-gold) / 0.82);
    --frame-line: 1.5px;
    --frame-line-offset: -1.5px;
    --frame-join-offset: calc(1rem - 3px);
    --frame-short-size: calc(1rem - 1.5px);
    --character-sheet-width: 49.22rem;
    --character-panel-bg: rgb(var(--color-base));

    box-sizing: border-box;
    position: relative;
    isolation: isolate;
    border: var(--frame-line) solid var(--frame-accent);
    background: var(--character-panel-bg);
    padding: 1.5rem;
  }

  .frame-corner {
    box-sizing: border-box;
    position: absolute;
    z-index: 2;
    width: 0.5rem;
    height: 0.5rem;
    border: var(--frame-line) solid var(--frame-accent);
    pointer-events: none;
  }

  .frame-corner::before,
  .frame-corner::after {
    content: "";
    position: absolute;
  }

  .frame-corner::before {
    width: var(--frame-short-size);
    height: 2rem;
  }

  .frame-corner::after {
    width: 2rem;
    height: var(--frame-short-size);
  }

  .frame-corner-top {
    top: -0.5rem;
  }

  .frame-corner-bottom {
    bottom: -0.5rem;
  }

  .frame-corner-left {
    left: -0.5rem;
  }

  .frame-corner-right {
    right: -0.5rem;
  }

  .frame-corner-left::before,
  .frame-corner-left::after {
    left: var(--frame-line-offset);
  }

  .frame-corner-left::before {
    border-left: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-left::after {
    left: var(--frame-join-offset);
    border-left: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-right::before,
  .frame-corner-right::after {
    right: var(--frame-line-offset);
  }

  .frame-corner-right::before {
    border-right: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-right::after {
    right: var(--frame-join-offset);
    border-right: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-top::before {
    top: var(--frame-join-offset);
    border-top: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-top::after {
    top: var(--frame-line-offset);
    border-top: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-bottom::before {
    bottom: var(--frame-join-offset);
    border-bottom: var(--frame-line) solid var(--frame-accent);
  }

  .frame-corner-bottom::after {
    bottom: var(--frame-line-offset);
    border-bottom: var(--frame-line) solid var(--frame-accent);
  }

  .character-header {
    --title-line: 1px;

    position: relative;
    z-index: 1;
    width: min(34rem, calc(100% - 4rem));
    margin: 0.5rem auto 2rem;
  }

  .character-title {
    --title-notch: 1rem;

    box-sizing: border-box;
    display: flex;
    position: relative;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    margin: 0;
    padding: 0 2.25rem;
    color: rgb(var(--color-text));
    font-size: 1.25rem;
    line-height: 1.5rem;
    text-align: center;
  }

  .character-title::before,
  .character-title::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .character-title::before {
    inset: 0;
    background-color: var(--frame-accent);
    clip-path: polygon(
      var(--title-notch) 0,
      calc(100% - var(--title-notch)) 0,
      100% 50%,
      calc(100% - var(--title-notch)) 100%,
      var(--title-notch) 100%,
      0 50%
    );
  }

  .character-title::after {
    inset: var(--title-line);
    background: var(--character-panel-bg);
    clip-path: polygon(
      calc(var(--title-notch) - var(--title-line)) 0,
      calc(100% - var(--title-notch) + var(--title-line)) 0,
      100% 50%,
      calc(100% - var(--title-notch) + var(--title-line)) 100%,
      calc(var(--title-notch) - var(--title-line)) 100%,
      0 50%
    );
  }

  .character-title span {
    position: relative;
    z-index: 1;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .character-body {
    display: grid;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .portrait-frame {
    display: grid;
    min-height: 39rem;
    margin: 0;
    overflow: hidden;
  }

  .portrait-art {
    min-height: 35rem;
    overflow: hidden;
    background:
      repeating-linear-gradient(
        0deg,
        rgb(var(--color-text) / 0.1) 0,
        rgb(var(--color-text) / 0.1) 1px,
        transparent 1px,
        transparent 4px
      ),
      radial-gradient(
        circle at 55% 15%,
        transparent 0 13%,
        rgb(var(--color-gold) / 0.24) 18%,
        rgb(var(--color-gold) / 0.1) 27%,
        transparent 38%
      ),
      radial-gradient(
        circle at 50% 24%,
        transparent 56%,
        rgb(var(--color-base) / 0.22)
      ),
      linear-gradient(
        180deg,
        rgb(var(--color-overlay) / 0.18),
        rgb(var(--color-base) / 0.22)
      );
  }

  .portrait-art picture,
  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .portrait-image {
    object-fit: cover;
    object-position: 50% 30%;
  }

  .character-details {
    padding: 0.25rem 0;
  }

  .character-abilities,
  .character-inventory {
    margin: 0.5rem 0 2.5rem;
    padding-left: 1.25rem;
  }

  .character-abilities li::marker,
  .character-inventory li::marker {
    color: rgb(var(--color-gold));
  }

  .character-mount {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    margin: 0.5rem 0 0;
  }

  .character-mount dt::after {
    content: ":";
  }

  .character-mount dd {
    margin: 0;
  }

  @media (max-width: 767px) {
    .character-sheet {
      padding: 1rem;
    }

    .character-header {
      width: calc(100% - 2rem);
      margin-bottom: 1.5rem;
    }

    .character-title {
      padding: 0 1.5rem;
      font-size: 1rem;
    }

    .portrait-frame {
      min-height: 0;
    }

    .portrait-art {
      min-height: 24rem;
    }
  }

  @media (min-width: 768px) {
    .character-sheet {
      width: min(var(--character-sheet-width), calc(100vw - 2rem));
      align-self: center;
    }

    .character-body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .character-sheet {
      --character-sheet-width: 57.42rem;
    }
  }
</style>
