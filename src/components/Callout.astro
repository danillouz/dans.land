---
interface Props {
  as?: "h1" | "p"
  id?: string
  lang?: string
  variant?: "default" | "not-found"
}

const { as: Tag = "p", id, lang, variant = "default" }: Props = Astro.props
---

<figure
  class:list={["callout", { "callout--not-found": variant === "not-found" }]}
>
  <Tag {id} {lang}><slot /></Tag>
</figure>

<style>
  .callout {
    --callout-color: var(--color-text);

    display: flex;
    width: 100%;
    max-width: 28rem;
    flex-direction: column;
    align-items: center;
    align-self: center;
    margin: 1rem 0;
    color: rgb(var(--callout-color));
    font-family: Georgia, "Times New Roman", serif;
    text-align: center;
  }

  .callout::before {
    content: "◆ ◆ ◆";
    margin-bottom: 0.875rem;
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    line-height: 1;
  }

  .callout::after {
    content: "";
    width: 7rem;
    margin-top: 1.25rem;
    border-top: 1.5px solid rgb(var(--callout-color) / 0.65);
  }

  .callout p {
    width: 100%;
    margin: 0;
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.875rem;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }

  .callout--not-found {
    margin: 1rem 0 4rem;
  }

  .callout--not-found h1 {
    width: 100%;
    margin: 0;
    font-size: 1.125rem;
    font-style: italic;
    font-weight: normal;
    line-height: 1.875rem;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }

  @media (prefers-color-scheme: light) {
    .callout {
      --callout-color: var(--color-pine);
    }
  }

  @media (prefers-color-scheme: dark) {
    .callout {
      --callout-color: var(--color-foam);
    }
  }

  @media (max-width: 799px) {
    .callout--not-found {
      margin-bottom: 3rem;
    }
  }
</style>
