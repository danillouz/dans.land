---
interface Props {
  as?: "h1" | "p"
  id?: string
  lang?: string
  variant?: "default" | "not-found"
}

const { as: Tag = "p", id, lang, variant = "default" }: Props = Astro.props
---

<figure
  class:list={["banner", { "banner--not-found": variant === "not-found" }]}
>
  <Tag {id} {lang}><slot /></Tag>
</figure>

<style>
  .banner {
    --banner-color: var(--banner-accent);

    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    align-self: center;
    margin: 1rem auto;
    color: rgb(var(--banner-color));
    font-family: Georgia, "Times New Roman", serif;
    text-align: center;
  }

  .banner::before {
    content: "◆ ◆ ◆";
    margin-bottom: 0.875rem;
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    line-height: 1;
  }

  .banner::after {
    content: "";
    width: 7rem;
    margin-top: 1.25rem;
    border-top: 1.5px solid rgb(var(--banner-color) / 0.65);
  }

  .banner p {
    width: 100%;
    margin: 0;
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.875rem;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }

  .banner--not-found {
    margin: 1rem auto 4rem;
  }

  .banner--not-found h1 {
    width: 100%;
    margin: 0;
    font-size: 1.125rem;
    font-style: italic;
    font-weight: normal;
    line-height: 1.875rem;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }

  @media (max-width: 799px) {
    .banner--not-found {
      margin-bottom: 3rem;
    }
  }
</style>
