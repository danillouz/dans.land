---
import "../styles/garden.css"
import { canonicalUrl } from "../urls"

import Base from "./Base.astro"
import Frame from "../components/Frame.astro"
import ShareMetadata from "../components/ShareMetadata.astro"

interface Props {
  title: string
  description: string
  article?: {
    created: Date
    updated?: Date
  }
}

const { title, description, article } = Astro.props
const canonical = canonicalUrl(Astro.url, Astro.site)
const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": `${canonical.href}#article`,
      headline: title,
      description,
      image: new URL("/social.png", Astro.site).href,
      url: canonical.href,
      inLanguage: "en",
      author: {
        "@type": "Person",
        "@id": "https://dans.land/#danillouz",
        name: "Daniël Illouz",
        url: "https://dans.land/about",
      },
      datePublished: article.created.toISOString(),
      ...(article.updated && { dateModified: article.updated.toISOString() }),
    }
  : undefined
---

<Base title={title} description={description} canonical={canonical}>
  <style is:inline slot="head">
    .expressive-code .copy button {
      opacity: 0;
    }
  </style>

  <ShareMetadata
    slot="head"
    title={title}
    description={description}
    canonical={canonical}
    openGraphType={article ? "article" : "website"}
    structuredData={structuredData}
  />
  {
    article && (
      <meta
        slot="head"
        property="article:published_time"
        content={article.created.toISOString()}
      />
    )
  }
  {
    article?.updated && (
      <meta
        slot="head"
        property="article:modified_time"
        content={article.updated.toISOString()}
      />
    )
  }

  <Frame>
    <slot />
  </Frame>
</Base>
