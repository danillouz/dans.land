---
import "../styles/page.css"
import { canonicalUrl } from "../urls"

import Base from "./Base.astro"
import Frame from "../components/Frame.astro"
import ShareMetadata from "../components/ShareMetadata.astro"

interface ShareMetadata {
  description: string
  openGraphType: "profile" | "website"
  structuredData: Record<string, unknown>
}

interface Props {
  title: string
  share?: ShareMetadata
  robots?: string
}

const { title, share, robots } = Astro.props

const canonical = share ? canonicalUrl(Astro.url, Astro.site) : undefined
---

<Base
  title={title}
  description={share?.description}
  canonical={canonical}
  robots={robots}
>
  <Fragment slot="head">
    {
      share && canonical && (
        <ShareMetadata {...share} title={title} canonical={canonical} />
      )
    }
  </Fragment>

  <Frame>
    <slot />
  </Frame>
</Base>
