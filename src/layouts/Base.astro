---
import "../styles/base.css"
import { Font } from "astro:assets"

interface Props {
  title: string
  description?: string
  canonical?: URL
  robots?: string
}

const { title, description, canonical, robots } = Astro.props
const rssBase = import.meta.env.DEV ? Astro.url : Astro.site
const rssUrl = rssBase && new URL("/rss.xml", rssBase)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fffaf3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#2a273f"
      media="(prefers-color-scheme: dark)"
    />

    <title>{title}</title>

    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}

    {canonical && <link rel="canonical" href={canonical} />}
    {
      rssUrl && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title="Dan's Land"
          href={rssUrl}
        />
      )
    }

    <Font cssVariable="--font-body" preload />

    <slot name="head" />
  </head>

  <body id="top">
    <slot />
  </body>
</html>
