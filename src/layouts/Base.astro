---
import "../styles/base.css"
import "@fontsource/ia-writer-quattro/400.css"
import "@fontsource/ia-writer-quattro/400-italic.css"
import "@fontsource/ia-writer-quattro/700.css"
import quattroRegular from "@fontsource/ia-writer-quattro/files/ia-writer-quattro-latin-400-normal.woff2?url"
import quattroItalic from "@fontsource/ia-writer-quattro/files/ia-writer-quattro-latin-400-italic.woff2?url"
import quattroBold from "@fontsource/ia-writer-quattro/files/ia-writer-quattro-latin-700-normal.woff2?url"

interface Props {
  title: string
  description?: string
  canonical?: URL
  robots?: string
}

const { title, description, canonical, robots } = Astro.props
const rssBase = import.meta.env.DEV ? Astro.url : Astro.site
const rssUrl = rssBase && new URL("/rss.xml", rssBase)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fffaf3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#2a273f"
      media="(prefers-color-scheme: dark)"
    />

    <title>{title}</title>

    {robots && <meta name="robots" content={robots} />}
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      rssUrl && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title="Dan's Land"
          href={rssUrl}
        />
      )
    }

    <link
      rel="preload"
      href={quattroRegular}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={quattroBold}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <!-- Discover the italic face early so emphasized text does not load it late. -->
    <link
      rel="preload"
      href={quattroItalic}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <slot name="head" />
  </head>

  <body id="top">
    <slot />
  </body>
</html>
