---
import Tree from "../../components/Tree.astro"
import { getPublishedGardenEntries } from "../../garden/collection"
import { gardenTree } from "../../garden/tree"
import Garden from "../../layouts/Garden.astro"

const entries = await getPublishedGardenEntries()
const tree = gardenTree([...entries].sort((a, b) => a.id.localeCompare(b.id)))
---

<Garden title="Garden Catalog" description="All posts in Dan's digital garden.">
  <h1>Catalog</h1>

  <Tree showRoot tree={tree} />
</Garden>
