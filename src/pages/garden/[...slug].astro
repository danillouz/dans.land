---
import type { CollectionEntry } from "astro:content"

import Backlinks from "../../components/Backlinks.astro"
import LinkPreview from "../../components/LinkPreview.astro"
import Mermaid from "../../components/Mermaid.astro"
import ToC from "../../components/ToC.astro"
import {
  getPublishedGardenEntries,
  renderGardenEntry,
} from "../../garden/collection"
import Garden from "../../layouts/Garden.astro"

interface Props {
  entry: CollectionEntry<"garden">
}

export async function getStaticPaths() {
  const entries = await getPublishedGardenEntries()

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, graph, headings, readingTime } = await renderGardenEntry(entry)
const hasMermaid = /(^|\n)```mermaid(?:\s|$)/.test(entry.body ?? "")
const created = entry.data.created
const updated = entry.data.updated
const folderSegment = entry.id.split("/").slice(0, -1).at(-1)
const folder = folderSegment
  ?.replaceAll("-", " ")
  .replace(/(^|\s)\p{Letter}/gu, (letter) => letter.toUpperCase())
const status = entry.data.status.replace(/^\p{Letter}/u, (letter) =>
  letter.toUpperCase(),
)
const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
  year: "numeric",
})
---

<Garden title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="post-header" data-link-preview-content>
      <p class="post-meta" aria-label="Post details">
        {
          folder && (
            <>
              <span>{folder}</span>
              <span class="post-meta-separator" aria-hidden="true">
                •
              </span>
            </>
          )
        }
        <span>{status}</span>
        <span class="post-meta-separator" aria-hidden="true">•</span>
        <span>{readingTime}</span>
        <span class="post-meta-separator" aria-hidden="true">•</span>
        <span>
          Planted{" "}
          <time datetime={created.toISOString().slice(0, 10)}>
            {dateFormatter.format(created)}
          </time>
        </span>
        {
          updated && (
            <>
              <span class="post-meta-separator" aria-hidden="true">
                •
              </span>
              <span>
                Last tended{" "}
                <time datetime={updated.toISOString().slice(0, 10)}>
                  {dateFormatter.format(updated)}
                </time>
              </span>
            </>
          )
        }
      </p>

      <h1>{entry.data.title}</h1>

      <p class="post-description">{entry.data.description}</p>
    </header>

    <ToC
      hasBacklinks={graph.backlinks.length > 0}
      headings={headings}
      title={entry.data.title}
    />

    <div class="garden-prose post-content" data-link-preview-content>
      <Content />
    </div>

    <Backlinks backlinks={graph.backlinks} />
  </article>

  {
    (graph.outgoingLinks.length > 0 || graph.backlinks.length > 0) && (
      <LinkPreview />
    )
  }

  {hasMermaid && <Mermaid />}
</Garden>

<style>
  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgb(var(--garden-border) / 0.65);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
  }

  .post-meta {
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    justify-content: flex-start;
    margin: 0 0 2rem;
    color: rgb(var(--garden-description));
    font-size: 1rem;
  }

  .post-meta-separator {
    color: rgb(var(--color-text));
  }

  .post-meta > span:not(.post-meta-separator) {
    white-space: nowrap;
  }

  .post-description {
    color: rgb(var(--color-text));
  }

  .post-content {
    overflow-wrap: break-word;
  }
</style>
