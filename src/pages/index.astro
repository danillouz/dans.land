---
import Ascii from "../components/Ascii.astro"
import Banner from "../components/Banner.astro"
import Intro from "../components/Intro.astro"
import Page from "../layouts/Page.astro"

const description =
  "Dan's Land is the personal site of Daniël Illouz: a fantasy realm of ASCII landscapes, backend engineering, immortal Gophers, and cinnamon buns."

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://dans.land/#website",
  name: "Dan's Land",
  alternateName: "dans.land",
  url: "https://dans.land/",
  description,
  inLanguage: "en",
  author: {
    "@type": "Person",
    "@id": "https://dans.land/#danillouz",
    name: "Daniël Illouz",
    url: "https://dans.land/about",
  },
}
---

<Page
  title="Dan's Land"
  share={{
    description,
    openGraphType: "website",
    structuredData,
  }}
