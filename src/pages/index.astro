<style>
  #gate,
  #sun {
    color: rgb(var(--color-gold));
  }

  #moon {
    color: rgb(var(--color-text));
  }

  #tower {
    color: rgb(var(--color-love));
  }

  #map {
    color: rgb(var(--color-subtle));
  }

  #map-legend {
    color: rgb(var(--color-caption));
  }

  .cloud {
    color: rgb(var(--color-muted));
  }

  .mountain {
    color: rgb(var(--color-subtle));
    text-shadow: none;
  }

  .water {
    color: rgb(var(--color-foam));
  }

  #links ul {
    margin: 0;
    list-style: square;
  }

  @media (prefers-color-scheme: light) {
    #sun {
      display: block;
    }

    #moon {
      display: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    #sun {
      display: none;
    }

    #moon {
      display: block;
    }
  }

  @media (min-width: 800px) {
    #links {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    #links:focus-within {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
  }
</style>
