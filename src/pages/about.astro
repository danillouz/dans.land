---
import { getImage, Picture } from "astro:assets"

import portrait from "../assets/portrait.png"

import Ascii from "../components/Ascii.astro"
import Intro from "../components/Intro.astro"
import Page from "../layouts/Page.astro"

const description =
  "Daniël Illouz is a backend engineer at Framer specializing in Go, high-performance backend systems, networking, and large-scale web infrastructure."
const portraitImage = await getImage({ src: portrait, format: "png" })

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://dans.land/about#profile",
  url: "https://dans.land/about",
  name: "About Daniël Illouz",
  inLanguage: "en",
  isPartOf: {
    "@id": "https://dans.land/#website",
  },
  mainEntity: {
    "@type": "Person",
    "@id": "https://dans.land/#danillouz",
    name: "Daniël Illouz",
    alternateName: ["Daniel Illouz", "Dan Illouz", "Dan", "danillouz"],
    url: "https://dans.land/about",
    image: new URL(portraitImage.src, Astro.site).href,
    jobTitle: "Backend engineer",
    description,
    worksFor: {
      "@type": "Organization",
      name: "Framer",
      url: "https://www.framer.com/",
    },
    sameAs: [
      "https://github.com/danillouz/",
      "https://www.linkedin.com/in/danillouz/",
    ],
  },
}
---

<Page
  title="Daniël Illouz"
  share={{
    description,
    openGraphType: "profile",
    structuredData,
  }}
>
  <Intro prefix="You stand before the..." title="High Warden">
    <Ascii slot="art">
      <pre
        id="warden-banner"
        aria-hidden="true">
                       *****    **                            *
                    ******  *  **** *   *                   **
                   **   *  *   *****   ***                  **
                  *    *  *    * *      *                   **
                      *  *     *                            **
                     ** **     *      ***         ****      **  ***
                     ** **     *       ***       *  ***  *  ** * ***
                     ** ********        **      *    ****   ***   ***
                     ** **     *        **     **     **    **     **
                     ** **     **       **     **     **    **     **
                     *  **     **       **     **     **    **     **
                        *       **      **     **     **    **     **
                    ****        **      **     **     **    **     **
                   *  *****      **     *** *   ********    **     **
                  *     **               ***      *** ***    **    **
                  *                                    ***         *
                   **                            ****   ***       *
                                               *******  **       *
                                              *     ****        *


     ***** *    **   ***                                 **
  ******  *  *****    ***                                 **
 **   *  *     *****   ***                                **
*    *  **     * **      **                               **
    *  ***     *         **            ***  ****          **
   **   **     *         **    ****     **** **** *   *** **      ***    ***  ****
   **   **     *         **   * ***  *   **   ****   *********   * ***    **** **** *
   **   **     *         **  *   ****    **         **   ****   *   ***    **   ****
   **   **     *         ** **    **     **         **    **   **    ***   **    **
   **   **     *         ** **    **     **         **    **   ********    **    **
    **  **     *         ** **    **     **         **    **   *******     **    **
     ** *      *         *  **    **     **         **    **   **          **    **
      ***      ***      *   **    **     ***        **    **   ****    *   **    **
       ******** ********     ***** **     ***        *****      *******    ***   ***
         ****     ****        ***   **                ***        *****      ***   ***</pre>
    </Ascii>
  </Intro>

  <div class="profile-copy">
    <p>Hi, I'm Dan.</p>

    <p>I used to fly commercial jets, but moved into software in 2012.</p>

    <p>
      I’m currently a backend engineer at{" "}
      <a href="https://www.framer.com/">Framer</a>, where I help turn product
      ideas into reliable software. I specialize in Go, high-performance backend
      systems, networking, and large-scale web infrastructure.
    </p>

    <p>
      Outside software I mostly read fantasy, ride my bike, go for walks, and
      have a weakness for cinnamon buns.
    </p>
  </div>

  <div class="portrait-exhibit">
    <figure class="portrait">
      <Picture
        src={portrait}
        formats={["avif", "webp"]}
        widths={[320, 480, 560, 672, 960, portrait.width]}
        sizes="(min-width: 800px) min(35rem, calc(100vw - 27.5rem)), min(70ch, calc(100vw - 2.5rem))"
        class="portrait-image"
        alt="Painting of Daniël Illouz in armor riding Silvester Stallion, a toy horse"
        priority
      />
    </figure>

    <aside class="placard" aria-labelledby="portrait-title">
      <h2 id="portrait-title">Daniël Illouz and Silvester Stallion</h2>

      <p class="placard-medium">Tokens on pixels</p>

      <p>
        Painted at the height of his reign, this portrait shows the High Warden
        with his faithful warhorse.
      </p>

      <p>
        Of noble polyester lineage, Sil was famed for his blistering top speed
        of 0 km/h and rumored to be bested only by stairs.
      </p>

      <p>
        Dan was said to possess the gift of incident foresight, its onset
        supposedly induced by cinnamon buns.
      </p>
    </aside>
  </div>
</Page>

<style>
  .profile-copy p {
    margin: 0 0 1.5rem;
  }

  .profile-copy p:last-of-type {
    margin-bottom: 0;
  }

  .portrait-exhibit {
    --placard-width: 23rem;

    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .portrait {
    margin: 0;
  }

  .portrait :global(picture),
  .portrait-image {
    display: block;
    width: 100%;
  }

  .portrait-image {
    height: auto;
    filter: drop-shadow(0 0.75rem 0.6rem rgb(0 0 0 / 0.22));
  }

  .placard {
    box-sizing: border-box;
    width: min(100%, var(--placard-width));
    justify-self: center;
    padding: 1.5rem;
    border: 1px solid rgb(var(--color-subtle) / 0.45);
    background: rgb(var(--color-base));
  }

  .placard h2 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5rem;
  }

  .placard p {
    margin: 1rem 0 0;
  }

  .placard .placard-medium {
    margin-top: 0.25rem;
    color: rgb(var(--color-caption));
    font-size: 0.875rem;
    line-height: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .placard .placard-medium::after {
    content: "";
    display: block;
    width: 3rem;
    margin-top: 1rem;
    border-top: 2px solid rgb(var(--color-iris) / 0.75);
  }

  @media (min-width: 800px) {
    .portrait-exhibit {
      width: min(60rem, calc(100vw - 2.5rem));
      grid-template-columns: minmax(0, 1fr) var(--placard-width);
      align-self: center;
    }
  }
</style>
